{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProcessFernbrookRefunds",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/fernbrook-orders"
    },
    {
      "Sid": "QueueRefundApprovals",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/fernbrook-refund-approvals"
    },
    {
      "Sid": "CheckRefundIdempotency",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/fernbrook-refund-idempotency"
    }
  ]
}
