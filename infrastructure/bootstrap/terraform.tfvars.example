# Copy to terraform.tfvars (gitignored) and fill in your own values.
github_owner = "YOUR-GITHUB-USERNAME"
github_repo  = "fernbrook-ops-agent"

# Optional: a monthly cost alert email (an alarm, not a cap).
# budget_email     = "you@example.com"
# budget_limit_usd = 25

# Only if your AWS account already has the GitHub OIDC provider registered:
# existing_github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
